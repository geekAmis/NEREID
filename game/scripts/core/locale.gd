func _ready() -> void:
	lang = "ru"

func t(key: String) -> String:
	var table: Dictionary = STRINGS.get(lang, STRINGS["ru"])
	return str(table.get(key, STRINGS["ru"].get(key, key)))

func set_lang(value: String) -> void:
	lang = value if STRINGS.has(value) else "ru"
	Game.settings["lang"] = lang
	Game.save_settings()
